            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "device_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Device Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "device_name"
        ],
        "title": "LoginDTO",
        "description": "登录请求传输对象，接收用户名、密码和设备名称。"
      },
      "LoginVO": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/UserVO"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "title": "LoginVO",
        "description": "登录结果展示对象，返回会话令牌、有效期和用户资料。"
      },
      "SessionVO": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "username",
          "expires_at"
        ],
        "title": "SessionVO",
        "description": "会话展示对象，返回当前登录用户和到期时间。"
      },
