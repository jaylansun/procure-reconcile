            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "contact_info",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "SupplierVO",
