# Copy to .local/deploy.env. Empty secrets intentionally make compose fail closed.
PROCURE_PG_ADMIN_PASSWORD=
PROCURE_PG_APP_PASSWORD=
PROCURE_INSTANCE_ID=procure-orbstack-production
# URL host is db inside the compose network, never 127.0.0.1.
PROCURE_DATABASE_URL=
PROCURE_SESSION_HOURS=24
PROCURE_IMAGE_TAG=local
# Optional LAN TLS overlay, after certs and trust are ready.
PROCURE_LAN_BIND=
PROCURE_HTTPS_PORT=18443
