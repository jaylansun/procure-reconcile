# Copy to server/.env. Password must match developer app role, not postgres admin.
PROCURE_ENVIRONMENT=development
PROCURE_INSTANCE_ID=procure-dev-local
PROCURE_DATABASE_URL=postgresql+psycopg://procure_app:REPLACE_WITH_DEV_APP_PASSWORD@127.0.0.1:15432/procure_dev
PROCURE_FILES_DIR=../.local/dev/files
PROCURE_SESSION_HOURS=24
